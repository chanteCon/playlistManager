# server
SERVER_URL=http://localhost
SERVER_PORT=4000

# tokens
ACCESS_TOKEN_SECRET=<replace with access token secret>
ACCESS_TOKEN_EXPIRES_IN=1800
REFRESH_TOKEN_EXPIRES_IN=604800

# redis
REDIS_URL=redis://localhost:6379

# db
DATABASE_URL=postgresql://postgres:password@localhost:5432/my_db
DB_PORT=5432

#email - Using MailHog, can start with docker-compose up and accessed at http://localhost:8025
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS= 
EMAIL_FROM="Dev App <noreply@example.com>"
EMAIL_FROM_NAME=app