{
    "name": "app",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "jest --verbose --coverage --selectProjects unit integration_e2e --maxWorkers=15",
        "verify": "npm run build && npm run lint && npm run test",
        "dev": "npm run docker:up && npm run migrate && cross-env NODE_ENV=development tsx watch src/server.ts",
        "clean": "rimraf dist",
        "build": "npm run clean && tsc && tsc-alias",
        "prestart": "npm run build",
        "start": "cross-env NODE_ENV=production node dist/server.js",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prisma:generate": "prisma generate",
        "migrate": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy",
        "docker:db": "docker-compose up -d db",
        "docker:up": "docker-compose up -d && node scripts/wait-for-db.js",
        "docker:down": "docker-compose down -v",
        "postinstall": "prisma generate",
        "generate:docs": "tsx openapi/generateOpenApi.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^3.0.3",
        "cheerio": "^1.2.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "rate-limit-redis": "^4.3.1",
        "redis": "^5.11.0",
        "swagger-ui-express": "^5.0.1",
        "yaml": "^2.9.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@faker-js/faker": "^7.6.0",
        "@jest/globals": "^30.4.1",
        "@swc/core": "^1.15.46",
        "@swc/jest": "^0.2.39",
        "@testcontainers/postgresql": "^12.0.4",
        "@testcontainers/redis": "^12.0.3",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.10.1",
        "@types/nodemailer": "^7.0.11",
        "@types/pg": "^8.18.0",
        "@types/supertest": "^7.2.0",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^8.48.1",
        "@typescript-eslint/parser": "^8.48.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.5.0",
        "jest": "^30.2.0",
        "prettier": "^3.8.1",
        "prisma": "^6.19.3",
        "rimraf": "^6.1.2",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "zod-openapi": "^5.4.6"
    }
}
