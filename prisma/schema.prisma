generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String @id@default(uuid())
  email             String @unique
  password          String
  username          String @unique
  verified          Boolean @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  isDemo            Boolean?


  refreshTokens     RefreshToken[]
  playlists         Playlist[]
  collections       Collection[]
}

model RefreshToken {
  id            String @id@default(uuid())
  tokenHash     String @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  revokedAt     DateTime?
  userId        String 
  deviceId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, deviceId])
}

enum Platform {
  youtube 
  tiktok
}

model Video {
  id                String@id@default(uuid())
  url               String @unique

  sourceId          String?
  source            VideoSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt
  playlistVideos    PlaylistVideo[]

}

model VideoSource {
  id                String@id@default(uuid())

  platform          Platform
  platformId        String
  canonicalUrl      String
  title             String?
  thumbnail         String?
  description       String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  videos            Video[]

  @@unique([platform, platformId])
}

model Playlist {
  id                String @id@default(uuid())
  userId            String
  name              String
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  coverUrl          String?

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistVideos    PlaylistVideo[]
  collections       CollectionPlaylist[]

  @@unique([userId, name])
}

model PlaylistVideo {
  id                String @id@default(uuid())
  playlistId        String
  videoId           String
  createdAt         DateTime @default(now())

  customTitle       String?
  customDescription String? 
  position          Int

  playlist          Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video             Video @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@unique([playlistId, videoId])
}

model Collection {
  id        String             @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  coverUrl    String?

  playlists CollectionPlaylist[]
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
@@unique([userId, name])
}

model CollectionPlaylist {
  collectionId String
  playlistId   String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  playlist   Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([collectionId, playlistId])
}